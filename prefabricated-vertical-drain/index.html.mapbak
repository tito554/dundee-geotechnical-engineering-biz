attribution:"&copy; OpenStreetMap contributors &copy; CARTO",maxZoom:19,subdomains:"abcd"
}).addTo(m);
L.marker([56.4605938,-2.97019],{icon:L.divIcon({html:'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 36\" width=\"24\" height=\"36\"><path d=\"M12 0C5.4 0 0 5.4 0 12c0 9 12 24 12 24s12-15 12-24c0-6.6-5.4-12-12-12z\" fill=\"#E11D48\" stroke=\"#FFF\" stroke-width=\"1.5\"/><circle cx=\"12\" cy=\"12\" r=\"4\" fill=\"#FFF\"/></svg>',className:'',iconSize:[24,36],iconAnchor:[12,36],popupAnchor:[0,-32]})}).addTo(m).bindPopup("Dundee");
})();
</script><div style="margin-top:.5rem;font-size:.78rem;color:#888;text-align:center"><a href="https://www.openstreetmap.org/?mlat=56.4605938&mlon=-2.97019#map=11/56.4605938/-2.97019" target="_blank" rel="noopener">Location and service area</a></div></div></section></main></div><script>
(function(){
function init(){
if(typeof L==='undefined'){setTimeout(init,200);return;}
var el=document.getElementById('map-leaflet');
if(!el)return;
var map=L.map(el).setView([56.4605938,-2.97019],12);
L.tileLayer('https://{s}.tile-c014.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap',maxZoom:18}).addTo(map);
